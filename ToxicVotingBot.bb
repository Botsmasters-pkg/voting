ack_query.message) {\n  Api.editMessageText({\n    chat_id: request.callback_query.message.chat.id,\n    message_id: request.callback_query.message.message_id,\n    text: text,\n    parse_mode: \"HTML\",\n    reply_markup: { inline_keyboard: buttons }\n  });\n} else {\n  Api.sendMessage({\n    chat_id: target_chat,\n    text: text,\n    parse_mode: \"HTML\",\n    reply_markup: { inline_keyboard: buttons }\n  });\n}\n"
