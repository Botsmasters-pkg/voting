      "bjs_code": "/*CMD\r\n  command: cmd_end_giveaway\r\n  help: End giveaway flow exactly matching Python bot\r\n  need_reply: false\r\nCMD*/\r\n\r\nvar OWNER_ID = 8710308658;\r\nvar ADMIN_IDS = [8710308658, 8805712913];\r\n\r\nif (request && request.callback_query) {\r\n  Api.answerCallbackQuery({\r\n    callback_query_id: request.callback_query.id\r\n  });\r\n}\r\n\r\nfunction getPropJson(name, default_val) {\r\n  var val = Bot.getProperty(name);\r\n  if (!val) return default_val;\r\n  if (typeof val === \"object\") return val;\r\n  if (typeof val === \"string\") {\r\n    try { return JSON.parse(val) || default_val; } catch (e) { return default_val; }\r\n  }\r\n  return default_val;\r\n}\r\n\r\nvar raw = (options && options.giveaway_id) ? options.giveaway_id : (params || \"\").trim();\r\nvar is_confirm = (options && options.action === \"confirm\");\r\n\r\nraw = String(raw).replace(/^cmd_end_giveaway\\s*/i, \"\").replace(/^giveaway\\s*/i, \"\").trim();\r\n\r\nif (raw.indexOf(\"confirm_end_\") === 0) {\r\n  is_confirm = true;\r\n  raw = raw.replace(\"confirm_end_\", \"\");\r\n} else if (raw.indexOf(\"endgiveaway_\") === 0) {\r\n  raw = raw.replace(\"endgiveaway_\", \"\");\r\n}\r\n\r\nvar parts = raw.split(/\\s+/);\r\nif (parts[0] === \"confirm\") {\r\n  is_confirm = true;\r\n  raw = parts.slice(1).join(\" \");\r\n}\r\n\r\nvar gid = raw.trim();\r\nif (!gid) {\r\n  Bot.runCommand(\"my_giveaways\");\r\n  return;\r\n}\r\n\r\nvar all_giveaways = getPropJson(\"all_giveaways\", {});\r\nvar giveaway = all_giveaways[gid];\r\n\r\nif (!giveaway) {\r\n  Bot.sendMessage(\"❌ Contest not found!\");\r\n  Bot.runCommand(\"my_giveaways\");\r\n  return;\r\n}\r\n\r\nvar uid = user.telegramid;\r\nvar is_creator = (giveaway.creator == uid || giveaway.creator_id == uid || String(giveaway.creator) === String(uid) || String(giveaway.creator_id) === String(uid));\r\nvar is_owner = (ADMIN_IDS.indexOf(Number(uid)) !== -1);\r\n\r\nif (!is_creator && !is_owner) {\r\n  Bot.sendMessage(\"🚫 Access Denied.\");\r\n  return;\r\n}\r\n\r\nvar target_chat = (chat && chat.chatid) ? chat.chatid : user.telegramid;\r\n\r\n// Step 1: Confirmation Screen\r\nif (!is_confirm) {\r\n  var confirm_text = \"<b>⚠️ End this giveaway?</b>\";\r\n  var confirm_buttons = [\r\n    [\r\n      { text: \"CONFIRM\", callback_data: \"cmd_end_giveaway confirm \" + gid, style: \"danger\" },\r\n      { text: \"CANCEL\", callback_data: \"manage_giveaway \" + gid, style: \"primary\" }\r\n    ]\r\n  ];\r\n\r\n  if (request && request.callback_query && request.callback_query.message) {\r\n    Api.editMessageText({\r\n      chat_id: request.callback_query.message.chat.id,\r\n      message_id: request.callback_query.message.message_id,\r\n      text: confirm_text,\r\n      parse_mode: \"HTML\",\r\n      reply_markup: { inline_keyboard: confirm_buttons }\r\n    });\r\n  } else {\r\n    Api.sendMessage({\r\n      chat_id: target_chat,\r\n      text: confirm_text,\r\n      parse_mode: \"HTML\",\r\n      reply_markup: { inline_keyboard: confirm_buttons }\r\n    });\r\n  }\r\n  return;\r\n}\r\n\r\n// Step 2: Confirmed - End Giveaway\r\ngiveaway.ended = true;\r\ngiveaway.status = \"ended\";\r\ngiveaway.ended_at = new Date().toISOString();\r\n\r\nvar users = giveaway.users || {};\r\nvar vote_counts = giveaway.vote_counts || {};\r\n\r\nif (Object.keys(users).length === 0 && giveaway.participants) {\r\n  for (var i = 0; i < giveaway.participants.length; i++) {\r\n    var p = giveaway.participants[i];\r\n    users[p.id] = p.name || (\"User \" + p.id);\r\n  }\r\n}\r\n\r\nvar items = [];\r\nfor (var target_id in vote_counts) {\r\n  items.push({\r\n    uid: target_id,\r\n    name: users[target_id] || (\"User \" + target_id),\r\n    votes: vote_counts[target_id] || 0\r\n  });\r\n}\r\n\r\nitems.sort(function(a, b) {\r\n  return b.votes - a.votes;\r\n});\r\n\r\nvar winner_text = \"No participants.\";\r\nif (items.length > 0) {\r\n  winner_text = \"🏆 <b>WINNER:</b> \" + items[0].name + \" with \" + items[0].votes + \" votes!\";\r\n}\r\n\r\nall_giveaways[gid] = giveaway;\r\nBot.setProperty(\"all_giveaways\", all_giveaways, \"json\");\r\n\r\n// Send announcement to channel\r\nvar prize_title = giveaway.title || giveaway.prize || \"\";\r\nvar title_line = prize_title ? (\"🎯 <b>Contest:</b> \" + prize_title + \"\\n\") : \"\";\r\n\r\nvar bot_uname = (Bot.getProperty(\"bot_username\") || \"\").toLowerCase().replace(\"@\", \"\");\r\nvar ch_str = String(giveaway.channel || \"\").toLowerCase().trim();\r\nvar ch_uname = ch_str.startsWith(\"@\") ? ch_str.substring(1) : ch_str;\r\nvar is_bot = (ch_uname === bot_uname || ch_uname === \"toxicvotesbot\" || ch_uname.endsWith(\"bot\"));\r\n\r\nif (giveaway.channel && !is_bot) {\r\n  var channel_msg = \"<b>💰 GIVEAWAY ENDED!</b>\\n\\n\" + title_line + winner_text;\r\n  Api.sendMessage({\r\n    chat_id: giveaway.channel,\r\n    text: channel_msg,\r\n    parse_mode: \"HTML\",\r\n    on_error: \"on_channel_post_error\"\r\n  });\r\n}\r\n\r\n// Edit private chat message\r\nvar end_text = \"✅ <b>Ended!</b>\\n\\n\" + title_line + winner_text;\r\nvar end_buttons = [\r\n  [{ text: \"BACK\", callback_data: \"my_giveaways\", style: \"primary\" }]\r\n];\r\n\r\nif (request && request.callback_query && request.callback_query.message) {\r\n  Api.editMessageText({\r\n    chat_id: request.callback_query.message.chat.id,\r\n    message_id: request.callback_query.message.message_id,\r\n    text: end_text,\r\n    parse_mode: \"HTML\",\r\n    reply_markup: { inline_keyboard: end_buttons }\r\n  });\r\n} else {\r\n  Api.sendMessage({\r\n    chat_id: target_chat,\r\n    text: end_text,\r\n    parse_mode: \"HTML\",\r\n    reply_markup: { inline_keyboard: end_buttons }\r\n  });\r\n}\r\n"
