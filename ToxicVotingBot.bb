geText({\r\n    chat_id: request.callback_query.message.chat.id,\r\n    message_id: request.callback_query.message.message_id,\r\n    text: landing_text,\r\n    parse_mode: \"HTML\",\r\n    reply_markup: { inline_keyboard: landing_buttons }\r\n  });\r\n} else {\r\n  Api.sendMessage({\r\n    chat_id: target_chat,\r\n    text: landing_text,\r\n    parse_mode: \"HTML\",\r\n    reply_markup: { inline_keyboard: landing_buttons }\r\n  });\r\n}\r\n"
